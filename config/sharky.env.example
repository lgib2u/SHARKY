# Copy this file to config/sharky.env and replace placeholders locally.
# config/sharky.env is ignored by Git.

ROS_DISTRO=replace-with-your-ros-distribution
ROS_DOMAIN_ID=replace-with-a-local-domain-id
RMW_IMPLEMENTATION=replace-with-your-rmw-implementation

SHARKY_HOSTNAME=replace-with-your-robot-hostname
SHARKY_SSH_USER=replace-with-your-local-user
SHARKY_WIFI_SSID=replace-with-your-network-name
SHARKY_WIFI_PSK=set-locally-never-commit

# The dashboard contains hardware controls and has no built-in authentication.
# Keep it on loopback unless it is protected by an authenticated local proxy.
SHARKY_BIND_HOST=127.0.0.1
