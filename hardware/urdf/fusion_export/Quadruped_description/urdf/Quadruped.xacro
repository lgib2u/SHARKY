<?xml version="1.0" ?>
<robot name="Quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Quadruped_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Quadruped_description)/urdf/Quadruped.trans" />
<xacro:include filename="$(find Quadruped_description)/urdf/Quadruped.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.007088275234648649 -8.948633213286523e-08 0.01453699304466451" rpy="0 0 0"/>
    <mass value="2.5561674884840873"/>
    <inertia ixx="0.001372" iyy="0.003795" izz="0.003659" ixy="-0.0" iyz="-0.0" ixz="-4.4e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Quadruped_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Quadruped_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>
